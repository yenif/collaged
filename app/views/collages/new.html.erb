<div id='header'>
  <h1>Create a Collage</h1>
</div>
<div id='new_collage_form' data-controller="collage-form">
  <form data-action="submit->collage-form#create">
    <ol>
      <li>
        <label for='title'>Title</label>
        <input type='text'
               id='title'
               name='collage[title]'
               data-collage-form-target="title"
               required />
      </li>
      <li>
        <div data-collage-form-target="errors" style="display: none; color: red;"></div>
      </li>
      <li>
        <input type='submit'
               class='button create'
               value='Create'
               data-collage-form-target="submit">
      </li>
    </ol>
  </form>
</div>
